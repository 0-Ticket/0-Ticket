# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 설정 파일에는 비밀 값 대신 아래 환경변수 이름만 적는다(예: api_key_env = "LLM_API_KEY").
# 결정 대장(docs/decisions.md)에서 확정되거나 설정에서 쓰는 이름만 여기에 추가한다.

# 조직 설정 파일 경로 (선택). 기본 설정 위에 덮어쓴다.
# ZT_CONFIG=

# 데이터베이스 (D-002 PostgreSQL)
# DATABASE_URL=

# LLM 제공자 키 (D-009). 설정의 api_key_env와 같은 이름을 쓴다.
# LLM_API_KEY=

# SIEM 연결 토큰 (D-006). 설정의 token_env와 같은 이름을 쓴다.
# SIEM_TOKEN=
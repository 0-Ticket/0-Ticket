# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 설정 파일에는 비밀 값 대신 아래 환경변수 이름만 적는다(예: api_key_env = "LLM_API_KEY").
# 결정 대장(docs/decisions.md)에서 확정되거나 설정에서 쓰는 이름만 여기에 추가한다.

# 조직 설정 파일 경로 (선택). 기본 설정 위에 덮어쓴다.
# ZT_CONFIG=

# 데이터베이스 (D-002 PostgreSQL). 설정 [database] url_env와 같은 이름을 쓴다.
# 형식: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB 이름>
# docker compose를 쓰면 아래 POSTGRES_* 값과 맞춘다.
# DATABASE_URL=
# 에이전트 도구(박스 15)가 쓰는 읽기 전용 계정. 설정 [database] readonly_url_env와 같은 이름을 쓴다.
# SELECT 권한만 준 계정을 쓴다. 형식은 위와 같다.
# DATABASE_READONLY_URL=

# 개발용 docker compose의 PostgreSQL 계정 (compose.yaml)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# LLM 제공자 키 (D-009). 설정의 api_key_env와 같은 이름을 쓴다.
# LLM_API_KEY=

# SIEM 연결 토큰 (D-006). 설정의 token_env와 같은 이름을 쓴다.
# SIEM_TOKEN=

# Wazuh 연결 사전검증 probe (#112, scripts/probe_wazuh.py). 이름은 probe의 --*-env 인자 기본값이다.
# indexer 계정은 wazuh-alerts-*·wazuh-archives-* 읽기 전용 role만 준다. API 계정은 인증 확인에만 쓴다.
# WAZUH_INDEXER_USER=
# WAZUH_INDEXER_PASSWORD=
# WAZUH_API_USER=
# WAZUH_API_PASSWORD=

# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 설정 파일에는 비밀 값 대신 아래 환경변수 이름만 적는다.
# 새 환경변수가 생기면 이름만 여기에 추가한다.

# 개발용 docker compose의 PostgreSQL 계정 (compose.yaml)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# RDB 주소. 형식: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB 이름>
# DATABASE_URL=

# LLM 제공자 키. 기본 LLM은 Azure Foundry gpt-oss-120b(D-009). Azure 계정 확정 전까지는 Groq 또는 Ollama 키
# 키가 필요 없는 제공자(Ollama)는 config/local.toml의 [llm] api_key_env를 빈 문자열로 둔다
# LLM_API_KEY=

# ELK 수집(uv run python -m soc.ingest). 주소는 계정 정보 없이 적고, 키는 읽기 전용 API 키(D-010)
# 이름은 config/default.toml의 [ingest] url_env·api_key_env와 맞춘다
# ELK_URL=
# ELK_API_KEY=

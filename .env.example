# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 설정 파일에는 비밀 값 대신 아래 환경변수 이름만 적는다.
# 새 환경변수가 생기면 이름만 여기에 추가한다.

# 개발용 docker compose의 PostgreSQL 계정 (compose.yaml)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# 원장 DB 주소. 형식: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB 이름>
# DATABASE_URL=

# LLM 제공자 키 (D-003, 기본 Groq)
# LLM_API_KEY=

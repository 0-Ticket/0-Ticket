# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 설정 파일에는 비밀 값 대신 아래 환경변수 이름만 적는다.
# 새 환경변수가 생기면 이름만 여기에 추가한다.

# 개발용 docker compose의 PostgreSQL 계정 (compose.yaml)
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# RDB 주소. 형식: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB 이름>
# DATABASE_URL=

# 에이전트 도구의 DB 주소(#211). 읽기 역할 soc_agent_reader의 멤버인 LOGIN 계정으로 접속한다.
# 형식: postgresql://<읽기 계정>:<비밀번호>@localhost:5432/<DB 이름>
# 계정 만드는 법은 docs/notes/211-tool-registry.md
# AGENT_DATABASE_URL=

# LLM 제공자 키. 기본 LLM은 Azure Foundry gpt-oss-120b(D-009). Azure 계정 확정 전까지는 Groq 또는 Ollama 키
# 키가 필요 없는 제공자(Ollama)는 config/local.toml의 [llm] api_key_env를 빈 문자열로 둔다
# LLM_API_KEY=

# ELK 주소와 읽기 전용 API 키. 수집(#218)과 SIEM 조회 도구(#212)가 함께 쓴다
# 주소 형식: https://<호스트>:9200 (계정 정보를 넣지 않는다). 키는 대상 인덱스의 read 권한만 준다
# ELK_URL=
# ELK_API_KEY=

# SSH 점검 도구(#213)의 OpenSSH 개인 키 본문(여러 줄). 읽기 권한만 가진 원격 계정의 키다
# 여러 줄 값이라 셸에서 넣는 법은 docs/notes/213-ssh-tool.md. 암호가 걸린 키면 그 암호를 아래에 두고
# config/local.toml의 [tools.ssh] passphrase_env에 이름을 적는다
# SSH_TOOL_PRIVATE_KEY=
# SSH_TOOL_KEY_PASSPHRASE=

# 벡터 DB 주소(#257). 형식: http://127.0.0.1:6333 (계정 정보를 넣지 않는다)
# 개발용은 compose.yaml의 qdrant 서비스다. Windows에서는 localhost가 IPv6로 먼저 풀려
# 요청마다 느려진다. 127.0.0.1로 적는다(docs/notes/257-vector-store-embedder.md)
# QDRANT_URL=

# 위협 인텔 조회 도구 lookup_indicator(#309)의 VirusTotal API 키(무료 키). 없으면 도구가 등록되지 않는다
# VT_API_KEY=

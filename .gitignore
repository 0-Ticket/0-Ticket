# 비밀 값 (.env, .env.local 등. 이름 목록만 담는 .env.example은 커밋)
.env*
!.env.example

# 공개 데이터셋 원본 (커밋 금지)
data/

# 조직 설정 (내부 주소·접속 대상, 커밋 금지)
config/local.*

# 개인 로컬 실험 환경(ELK 컨테이너, 합성 데이터 적재 스크립트). 커밋하지 않는다
.local/

# Python · uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 개인 설정
CLAUDE.local.md
.claude/settings.local.json


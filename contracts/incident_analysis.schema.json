{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_analysis.schema.json",
  "title": "IncidentAnalysis",
  "description": "L2 Incident 보고 run의 출력",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict", "title", "summary", "assessed_severity", "techniques", "impact", "cause",
    "further_risk", "recommendations", "evidence_ids"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["not_threat", "attempted", "succeeded", "inconclusive"]
    },
    "title": {
      "description": "사건을 한 줄로 설명하는 제목. 길이·pattern을 두지 않는다: 빈 값이나 긴 값이 계약 오류가 되면 분석 전체가 실패해 같은 Incident를 다시 분석한다(D-059 유형). 저장할 때 soc.ticketing.clean_title로 정리하고, 정리 결과가 폴백이면 Incident 제목을 덮어쓰지 않는다(D-072)",
      "type": "string"
    },
    "summary": {"type": "string", "minLength": 1},
    "assessed_severity": {"$ref": "common/types.schema.json#/definitions/severity"},
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
          }
        }
      }
    },
    "impact": {"type": "string"},
    "cause": {"type": "string"},
    "further_risk": {"type": "string"},
    "recommendations": {
      "description": "권고 조치. 대응과 탐지 룰을 한 목록에 둔다(D-072). 한도를 넘으면 자르지 않고 거부한다",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "priority", "title", "detail", "rationale"],
        "properties": {
          "kind": {"type": "string", "enum": ["response", "detection"]},
          "priority": {"type": "string", "enum": ["high", "medium", "low"]},
          "title": {
            "description": "한 줄. 공백(탭·LF·VT·FF·CR·공백·U+00A0·U+3000)뿐인 값은 허용하지 않는다. Ticket 제목(D-070)과 같은 pattern",
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\t\\n\\u000b\\f\\r \\u00a0\\u3000]*[^\\t\\n\\u000b\\f\\r \\u00a0\\u3000][\\s\\S]*$"
          },
          "detail": {
            "description": "구체적인 조치. 탐지 룰이면 룰 내용",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "rationale": {
            "description": "이 사건의 어떤 사실 때문에 필요한지",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "evidence_ids": {
      "description": "어느 기법에도 붙지 않은 근거. 비어도 된다",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
    }
  }
}

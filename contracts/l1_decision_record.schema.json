{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "l1_decision_record.schema.json",
  "title": "L1DecisionRecord",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^ld_"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "alert",
        "ticket"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "l1_escalated",
        "held",
        "closed_fp",
        "l2_escalated"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "below_threshold",
        "llm_failure",
        "evidence_request_failure",
        null
      ]
    },
    "created_at": {
      "type": "integer"
    }
  },
  "required": [
    "decision_id",
    "subject_type",
    "subject_id",
    "decision",
    "confidence",
    "reason",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "alert"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "pattern": "^al_"
          },
          "decision": {
            "enum": [
              "l1_escalated",
              "held"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "ticket"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "pattern": "^tk_"
          },
          "decision": {
            "enum": [
              "held",
              "closed_fp",
              "l2_escalated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "held"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}

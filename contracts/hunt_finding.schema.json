{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hunt_finding.schema.json",
  "title": "HuntFinding",
  "type": "object",
  "properties": {
    "hunt_id": {
      "type": "string",
      "pattern": "^ht_"
    },
    "hypothesis": {
      "type": "string"
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": "string",
      "enum": [
        "baseline",
        "hypothesis"
      ]
    },
    "query_summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "is_anomaly": {
      "type": "boolean"
    },
    "severity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Severity on the C3 scale (0-6); non-anomalous findings have severity 0."
    },
    "incident_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^in_"
    },
    "rule_candidate": {
      "type": "boolean"
    },
    "needs_human": {
      "type": "boolean"
    },
    "human_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "integer"
    }
  },
  "required": [
    "hunt_id",
    "hypothesis",
    "techniques",
    "method",
    "query_summary",
    "evidence",
    "is_anomaly",
    "severity_id",
    "incident_id",
    "rule_candidate",
    "needs_human",
    "human_reason",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "needs_human": {
            "const": true
          }
        },
        "required": [
          "needs_human"
        ]
      },
      "then": {
        "properties": {
          "human_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_anomaly": {
            "const": false
          }
        },
        "required": [
          "is_anomaly"
        ]
      },
      "then": {
        "properties": {
          "severity_id": {
            "const": 0
          }
        }
      }
    }
  ],
  "description": "Core follow-up: evidence existence and Correlation linkage; LLM fallback."
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_findings.schema.json",
  "title": "IncidentFindings",
  "description": "L2 Incident 조사 run의 출력. 사실과 그 근거만 담는다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timeline",
    "entities",
    "evidence_ids",
    "siem_refs"
  ],
  "properties": {
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "summary",
          "evidence_ids"
        ],
        "properties": {
          "time": {
            "$ref": "common/types.schema.json#/definitions/epoch_ms"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common/types.schema.json#/definitions/evidence_id"
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "evidence_ids"
        ],
        "properties": {
          "entity": {
            "$ref": "common/entity.schema.json"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common/types.schema.json#/definitions/evidence_id"
            }
          }
        }
      }
    },
    "evidence_ids": {
      "description": "어느 항목에도 붙지 않은 근거. 비어도 된다",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common/types.schema.json#/definitions/evidence_id"
      }
    },
    "siem_refs": {
      "description": "근거로 쓰려고 고른 SIEM 문서의 저장 키(#382). evidence_ids와 별개다(아직 ID가 없다). 이 run의 도구 결과에 보인 것만 쓸 수 있고, 워커가 가져와 저장한 뒤 evt_ ID를 발급하면 보고 단계가 그 ID로 인용한다. 중복 없음",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common/types.schema.json#/definitions/siem_ref"
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_findings.schema.json",
  "title": "IncidentFindings",
  "description": "L2 Incident 조사 run의 출력. 사실과 그 근거만 담는다",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeline", "entities", "evidence_ids"],
  "properties": {
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "summary", "evidence_ids"],
        "properties": {
          "time": {"$ref": "common/types.schema.json#/definitions/epoch_ms"},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "evidence_ids"],
        "properties": {
          "entity": {"$ref": "common/entity.schema.json"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
          }
        }
      }
    },
    "evidence_ids": {
      "description": "어느 항목에도 붙지 않은 근거. 비어도 된다",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
    }
  }
}

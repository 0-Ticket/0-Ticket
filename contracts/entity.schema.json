{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity.schema.json",
  "title": "Entity",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Registered value; built-in values: ip, host, user. Plugins may register more values; the core registry validates them."
    },
    "value": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "value"
  ],
  "additionalProperties": false
}

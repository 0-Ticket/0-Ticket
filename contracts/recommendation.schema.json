{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recommendation.schema.json",
  "title": "Recommendation",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reversible": {
      "type": "boolean"
    }
  },
  "required": [
    "action",
    "risk",
    "reversible"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest_run.schema.json",
  "title": "IngestRun",
  "description": "수집 대상 하나를 한 번 실행한 기록. 실행마다 하나씩 쌓인다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siem_profile",
    "source_kind",
    "source_key",
    "started_at",
    "finished_at",
    "outcome",
    "pages",
    "inserted"
  ],
  "properties": {
    "siem_profile": {
      "description": "가져온 SIEM 연결 프로필 이름. IngestCheckpoint의 siem_profile과 같다",
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": ["alert", "event"]
    },
    "source_key": {
      "description": "설정에 적은 조회 대상. IngestCheckpoint의 source_key와 같다",
      "type": "string",
      "minLength": 1
    },
    "started_at": {"$ref": "common/types.schema.json#/definitions/epoch_ms"},
    "finished_at": {"$ref": "common/types.schema.json#/definitions/epoch_ms"},
    "outcome": {
      "description": "성공이면 ok, 실패면 실패 원인의 종류 코드. 원문과 비밀은 넣지 않는다",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pages": {
      "description": "저장까지 끝난 페이지 수. 빈 페이지는 세지 않는다",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "inserted": {
      "description": "이 실행에서 새로 저장한 원본 수. 이미 있던 문서는 세지 않는다",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}

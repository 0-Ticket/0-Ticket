{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case_task.schema.json",
  "title": "CaseTask",
  "type": "object",
  "properties": {
    "task": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "due_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    }
  },
  "required": [
    "task",
    "owner",
    "due_at",
    "status"
  ],
  "additionalProperties": false
}

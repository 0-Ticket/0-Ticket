{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ticket.schema.json",
  "title": "Ticket",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^tk_"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "triaging",
        "awaiting_human",
        "closed_benign",
        "closed_fp",
        "escalated"
      ]
    },
    "handling_type": {
      "type": "string",
      "description": "Registered value; built-in values: web_attack, scan, cloud, other. Plugins may register more values; the core registry validates them."
    },
    "specialist": {
      "type": "string",
      "description": "Registered value; built-in values: none, web, cloud. Plugins may register more values; the core registry validates them."
    },
    "priority": {
      "type": "integer"
    },
    "alert_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^al_"
      },
      "minItems": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "entity.schema.json"
      }
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "verdict.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[^.]+\\..+$"
      }
    },
    "created_at": {
      "type": "integer"
    },
    "updated_at": {
      "type": "integer"
    }
  },
  "required": [
    "ticket_id",
    "status",
    "handling_type",
    "specialist",
    "priority",
    "alert_ids",
    "entities",
    "verdict",
    "extensions",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "description": "Core follow-up: enforce state transitions and calculate priority from severity and target asset criticality."
}

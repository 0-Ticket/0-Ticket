{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "branch_result.schema.json",
  "title": "BranchResult",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "pattern": "^br_"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "alert",
        "ticket"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "enum": [
        "deduplicated",
        "excluded_shared_entity",
        "scenario_ticket",
        "l1_entity_lookup",
        "existing_incident",
        "new_incident"
      ]
    },
    "reason": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "entity.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "rule_id",
        "entity"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "rule_id": {
              "type": "string"
            }
          },
          "required": [
            "rule_id"
          ]
        },
        {
          "properties": {
            "entity": {
              "$ref": "entity.schema.json"
            }
          },
          "required": [
            "entity"
          ]
        }
      ]
    },
    "created_at": {
      "type": "integer"
    }
  },
  "required": [
    "branch_id",
    "subject_type",
    "subject_id",
    "path",
    "reason",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "alert"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "pattern": "^al_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "ticket"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "pattern": "^tk_"
          }
        }
      }
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_member.schema.json",
  "title": "IncidentMember",
  "type": "object",
  "properties": {
    "member_type": {
      "type": "string",
      "enum": [
        "ticket",
        "hunt"
      ]
    },
    "ticket_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^tk_"
    },
    "hunt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ht_"
    },
    "source": {
      "type": "string",
      "enum": [
        "l1",
        "human_l1",
        "l3"
      ]
    },
    "rule": {
      "type": "string"
    },
    "matched_entity": {
      "anyOf": [
        {
          "$ref": "entity.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded": {
      "type": "boolean"
    },
    "excluded_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "member_type",
    "ticket_id",
    "hunt_id",
    "source",
    "rule",
    "matched_entity",
    "excluded",
    "excluded_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "member_type": {
            "const": "ticket"
          }
        },
        "required": [
          "member_type"
        ]
      },
      "then": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^tk_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "member_type": {
            "const": "hunt"
          }
        },
        "required": [
          "member_type"
        ]
      },
      "then": {
        "properties": {
          "hunt_id": {
            "type": "string",
            "pattern": "^ht_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "excluded": {
            "const": true
          }
        },
        "required": [
          "excluded"
        ]
      },
      "then": {
        "properties": {
          "excluded_reason": {
            "type": "string"
          }
        }
      }
    }
  ]
}

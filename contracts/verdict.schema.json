{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verdict.schema.json",
  "title": "Verdict",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "tp",
        "fp",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 1
    },
    "recommended_action": {
      "type": "string"
    },
    "needs_human": {
      "type": "boolean"
    },
    "human_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "verdict",
    "confidence",
    "summary",
    "evidence",
    "recommended_action",
    "needs_human",
    "human_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "needs_human": {
            "const": true
          }
        },
        "required": [
          "needs_human"
        ]
      },
      "then": {
        "properties": {
          "human_reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "Core follow-up: evidence reference policy (alert, event, raw) and existence, LLM fallback; recommended actions are never executed."
}

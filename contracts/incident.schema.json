{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident.schema.json",
  "title": "Incident",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^in_"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "closed_benign",
        "escalated_to_case"
      ]
    },
    "created_by": {
      "type": "string",
      "enum": [
        "correlation",
        "manual"
      ]
    },
    "severity_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "Maximum severity among non-excluded members: C5 alert severity for tickets, C17 severity for hunts. Computed by the core."
    },
    "first_seen": {
      "type": "integer"
    },
    "last_seen": {
      "type": "integer"
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "incident_member.schema.json"
      }
    },
    "review_state": {
      "type": "string",
      "enum": [
        "analyzing",
        "awaiting_review",
        "approved",
        "human_handling"
      ],
      "description": "L2 review workflow state, separate from the Incident lifecycle status. Set by the core (box 21)."
    },
    "review_round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Round of the currently open L2 review opportunity. Integer only while awaiting_review, otherwise null. Assigned by the core; increases monotonically per Incident."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[^.]+\\..+$"
      }
    }
  },
  "required": [
    "incident_id",
    "title",
    "status",
    "created_by",
    "severity_id",
    "first_seen",
    "last_seen",
    "tactics",
    "summary",
    "members",
    "review_state",
    "review_round",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_state": {
            "const": "awaiting_review"
          }
        },
        "required": [
          "review_state"
        ]
      },
      "then": {
        "properties": {
          "review_round": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "review_round": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Core follow-up: only Correlation creates incidents, computes member severity and grouping provenance. Review state transitions and round assignment are core follow-ups (box 21)."
}

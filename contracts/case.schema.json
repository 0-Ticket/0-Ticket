{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case.schema.json",
  "title": "Case",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^cs_"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^in_"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responding",
        "closed"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "case_task.schema.json"
      }
    },
    "lessons": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[^.]+\\..+$"
      }
    },
    "created_at": {
      "type": "integer"
    },
    "closed_at": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "case_id",
    "incident_id",
    "title",
    "status",
    "tasks",
    "lessons",
    "extensions",
    "created_at",
    "closed_at"
  ],
  "additionalProperties": false,
  "description": "Core follow-up: create only after approval, maintain closure state and indexing."
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common/types.schema.json",
  "title": "Types",
  "description": "여러 계약이 함께 쓰는 값의 정의. ID는 접두사 + UUIDv7(소문자 16진수).",
  "definitions": {
    "epoch_ms": {
      "description": "UTC epoch 밀리초. 상한은 9999-12-30T23:59:59.999Z(+14시간 시간대로 읽어도 9999년 안)",
      "type": "integer",
      "minimum": 0,
      "maximum": 253402214399999
    },
    "severity": {
      "description": "OCSF severity_id. 0 Unknown, 1 Informational, 2 Low, 3 Medium, 4 High, 5 Critical, 6 Fatal",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "raw_id": {"type": "string", "pattern": "^raw_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "alert_id": {"type": "string", "pattern": "^alt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "ticket_id": {"type": "string", "pattern": "^tkt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "incident_id": {"type": "string", "pattern": "^inc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "proposal_id": {"type": "string", "pattern": "^prp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "case_id": {"type": "string", "pattern": "^cas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "agent_log_id": {"type": "string", "pattern": "^agl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hunt_id": {"type": "string", "pattern": "^hnt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "hunt_run_id": {
      "description": "같은 가설 생성 실행에서 나온 Hunt 묶음. Agent Log의 run_id(에이전트 실행 한 번)와 다른 ID다",
      "type": "string",
      "pattern": "^hrn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hunt_subject_id": {
      "description": "Agent Log의 hunt 대상. 가설 생성 run은 hrn_, 검증 run은 hnt_ ID",
      "type": "string",
      "pattern": "^(hnt|hrn)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidence_id": {
      "description": "판정 근거. Alert·Event ID 또는 도구 호출 기록(Agent Log) ID",
      "type": "string",
      "pattern": "^(alt|evt|agl)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}

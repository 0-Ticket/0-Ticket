{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common/verdict.schema.json",
  "title": "Verdict",
  "description": "L1 판정. Alert의 1차 판정과 Ticket 판정이 같은 모양을 쓴다",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "reason", "evidence_ids", "decided_at"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["benign", "malicious", "undetermined"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "description": "판정 이유",
      "type": "string"
    },
    "evidence_ids": {
      "description": "판정 근거가 된 Alert·Event ID와 도구 호출 기록 ID",
      "type": "array",
      "items": {"$ref": "types.schema.json#/definitions/evidence_id"}
    },
    "decided_at": {"$ref": "types.schema.json#/definitions/epoch_ms"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent_log.schema.json",
  "title": "AgentLog",
  "description": "에이전트의 모델 호출·도구 호출 한 번. 같은 작업의 호출은 run_id로 묶고 seq로 순서를 둔다. 비밀 값은 넣지 않는다",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "stage",
    "subject_type",
    "subject_id",
    "seq",
    "kind",
    "name",
    "input",
    "output",
    "outcome",
    "tokens_in",
    "tokens_out",
    "started_at",
    "duration_ms",
    "details"
  ],
  "properties": {
    "id": {"$ref": "common/types.schema.json#/definitions/agent_log_id"},
    "run_id": {"$ref": "common/types.schema.json#/definitions/run_id"},
    "stage": {
      "type": "string",
      "enum": ["l1", "l2", "l3"]
    },
    "subject_type": {
      "description": "alert는 L1 1차 판정",
      "type": "string",
      "enum": ["alert", "ticket", "incident", "hunt"]
    },
    "subject_id": {
      "description": "대상 ID. alert는 alt_, ticket은 tkt_, incident는 inc_ ID. hunt는 Hunt ID 형식이 정해지기 전까지 빈 문자열만 거부한다",
      "type": "string"
    },
    "seq": {
      "description": "작업 안 순번. (run_id, seq)는 유일",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "kind": {
      "type": "string",
      "enum": ["model", "tool"]
    },
    "name": {
      "description": "모델 이름 또는 도구 이름",
      "type": "string"
    },
    "input": {
      "description": "입력 전체(JSON 값). 공격자가 쓴 문자열이 들어갈 수 있다"
    },
    "output": {
      "description": "출력 전체(JSON 값). 실패해 출력이 없으면 null"
    },
    "outcome": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "tokens_in": {
      "description": "모델 호출만. 도구 호출은 null",
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 2147483647},
        {"type": "null"}
      ]
    },
    "tokens_out": {
      "description": "모델 호출만. 도구 호출은 null",
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 2147483647},
        {"type": "null"}
      ]
    },
    "started_at": {"$ref": "common/types.schema.json#/definitions/epoch_ms"},
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "details": {
      "description": "계약에 없는 값. 다른 단계는 읽지 않는다",
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "tool"}}},
      "then": {"properties": {"tokens_in": {"type": "null"}, "tokens_out": {"type": "null"}}}
    },
    {
      "if": {"required": ["subject_type"], "properties": {"subject_type": {"const": "alert"}}},
      "then": {"properties": {"subject_id": {"$ref": "common/types.schema.json#/definitions/alert_id"}}}
    },
    {
      "if": {"required": ["subject_type"], "properties": {"subject_type": {"const": "ticket"}}},
      "then": {"properties": {"subject_id": {"$ref": "common/types.schema.json#/definitions/ticket_id"}}}
    },
    {
      "if": {"required": ["subject_type"], "properties": {"subject_type": {"const": "incident"}}},
      "then": {"properties": {"subject_id": {"$ref": "common/types.schema.json#/definitions/incident_id"}}}
    },
    {
      "if": {"required": ["subject_type"], "properties": {"subject_type": {"const": "hunt"}}},
      "then": {"properties": {"subject_id": {"minLength": 1}}}
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "l2_review.schema.json",
  "title": "L2Review",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^in_"
    },
    "reviewer": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reject_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "wrong_grouping",
        "missing_step",
        "wrong_conclusion",
        null
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "integer"
    }
  },
  "required": [
    "incident_id",
    "reviewer",
    "decision",
    "reject_type",
    "comment",
    "round",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "reject"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "reject_type": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "round records the C10 review_round of the opportunity this review handled; the core assigns it and routes the second rejection to human_handling."
}

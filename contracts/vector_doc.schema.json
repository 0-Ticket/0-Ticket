{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vector_doc.schema.json",
  "title": "VectorDoc",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^doc_"
    },
    "collection": {
      "type": "string",
      "description": "Registered value; built-in values: closed_tickets, closed_incidents, cases, assets, alerts_summary, events_rare. Plugins may register more values; the core registry validates them."
    },
    "text": {
      "type": "string"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "ticket",
        "incident",
        "case",
        "asset",
        "alert",
        "event"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "integer"
    },
    "expires_at": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "doc_id",
    "collection",
    "text",
    "source_kind",
    "source_id",
    "keywords",
    "created_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "description": "Core follow-up: closed_tickets, closed_incidents and cases collections require finalized source records."
}

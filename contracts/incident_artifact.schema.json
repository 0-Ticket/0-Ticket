{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_artifact.schema.json",
  "title": "IncidentArtifact",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^in_"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "timeline_entry.schema.json"
      }
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "iocs": {
      "type": "array",
      "items": {
        "$ref": "ioc.schema.json"
      }
    },
    "suspected_cause": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "recommendation.schema.json"
      }
    },
    "needs_human": {
      "type": "boolean"
    },
    "human_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "integer"
    }
  },
  "required": [
    "incident_id",
    "timeline",
    "affected_assets",
    "iocs",
    "suspected_cause",
    "recommendations",
    "needs_human",
    "human_reason",
    "generated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "needs_human": {
            "const": true
          }
        },
        "required": [
          "needs_human"
        ]
      },
      "then": {
        "properties": {
          "human_reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "Core follow-up: chronological timeline and evidence existence; LLM fallback."
}

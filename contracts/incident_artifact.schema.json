{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "incident_artifact.schema.json",
  "title": "IncidentArtifact",
  "description": "사람 검토가 읽는 L2 Incident 분석 결과",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "incident_id", "analysis_round", "verdict", "summary", "assessed_severity",
    "timeline", "techniques", "impact", "cause", "further_risk", "evidence_ids", "created_at"
  ],
  "properties": {
    "id": {"$ref": "common/types.schema.json#/definitions/artifact_id"},
    "incident_id": {"$ref": "common/types.schema.json#/definitions/incident_id"},
    "analysis_round": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "verdict": {
      "type": "string",
      "enum": ["not_threat", "attempted", "succeeded", "inconclusive"]
    },
    "summary": {"type": "string", "minLength": 1},
    "assessed_severity": {"$ref": "common/types.schema.json#/definitions/severity"},
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "summary", "evidence_ids"],
        "properties": {
          "time": {"$ref": "common/types.schema.json#/definitions/epoch_ms"},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
          }
        }
      }
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
          "name": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
          }
        }
      }
    },
    "impact": {"type": "string"},
    "cause": {"type": "string"},
    "further_risk": {"type": "string"},
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common/types.schema.json#/definitions/evidence_id"}
    },
    "created_at": {"$ref": "common/types.schema.json#/definitions/epoch_ms"}
  },
  "allOf": [
    {
      "if": {
        "required": ["verdict"],
        "properties": {
          "verdict": {
            "enum": ["not_threat", "attempted", "succeeded"]
          }
        }
      },
      "then": {
        "properties": {
          "timeline": {"minItems": 1},
          "evidence_ids": {"minItems": 1}
        }
      }
    }
  ]
}

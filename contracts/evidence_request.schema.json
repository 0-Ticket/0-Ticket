{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence_request.schema.json",
  "title": "EvidenceRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^rq_"
    },
    "requester_type": {
      "type": "string",
      "enum": [
        "ticket",
        "incident",
        "alert"
      ]
    },
    "requester_id": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "specialist_agent",
        "siem_mcp",
        "lookup"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ],
      "description": "Registered specialist domain; built-in domains are web and cloud. Cloud support is deferred."
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "description": "What to read. Its shape depends on request_type."
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Result of a completed request; null in every other status. Its shape depends on request_type."
    },
    "created_at": {
      "type": "integer"
    },
    "updated_at": {
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "requester_type",
    "requester_id",
    "request_type",
    "domain",
    "params",
    "retry_count",
    "status",
    "failure_reason",
    "result",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "requester_type": {
            "const": "ticket"
          }
        },
        "required": [
          "requester_type"
        ]
      },
      "then": {
        "properties": {
          "requester_id": {
            "pattern": "^tk_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requester_type": {
            "const": "incident"
          }
        },
        "required": [
          "requester_type"
        ]
      },
      "then": {
        "properties": {
          "requester_id": {
            "pattern": "^in_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requester_type": {
            "const": "alert"
          }
        },
        "required": [
          "requester_type"
        ]
      },
      "then": {
        "properties": {
          "requester_id": {
            "pattern": "^al_"
          },
          "request_type": {
            "enum": [
              "siem_mcp",
              "lookup"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "specialist_agent"
          }
        },
        "required": [
          "request_type"
        ]
      },
      "then": {
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "domain": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "failure_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "specialist_agent"
          }
        },
        "required": [
          "request_type"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "siem_mcp"
          }
        },
        "required": [
          "request_type"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "entity.schema.json"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "alert",
                  "event"
                ]
              },
              "start_at": {
                "type": "integer"
              },
              "end_at": {
                "type": "integer"
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "entity",
              "kind",
              "start_at",
              "end_at",
              "limit"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "lookup"
          }
        },
        "required": [
          "request_type"
        ]
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "entity": {
                "$ref": "entity.schema.json"
              },
              "at": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "entity",
              "at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "specialist_agent"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "request_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "finding": {
                "$ref": "specialist_finding.schema.json"
              }
            },
            "required": [
              "finding"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "siem_mcp"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "request_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "records": {
                "type": "array",
                "items": {
                  "$ref": "siem_alert.schema.json"
                }
              }
            },
            "required": [
              "records"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_type": {
            "const": "lookup"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "request_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "asset": {
                "anyOf": [
                  {
                    "$ref": "asset_info.schema.json"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "user": {
                "anyOf": [
                  {
                    "$ref": "user_info.schema.json"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "asset",
              "user"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}

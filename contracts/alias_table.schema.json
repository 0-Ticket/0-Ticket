{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alias_table.schema.json",
  "title": "AliasTable",
  "type": "object",
  "properties": {
    "scenario": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "alert",
        "event"
      ]
    },
    "class_uid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "activity": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "time_format": {
      "type": "string"
    },
    "severity_map": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "default_techniques": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "extensions_map": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "scenario",
    "kind",
    "class_uid",
    "activity",
    "fields",
    "time_format",
    "severity_map",
    "default_techniques",
    "extensions_map"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "alert"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "class_uid": {
            "const": 2004
          },
          "severity_map": {
            "type": "object"
          }
        }
      }
    }
  ],
  "description": "Core follow-up: scenario lookup, alias mapping, time/severity conversion and NormalizeFailure creation. Empty optional list uses []."
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ingest_quarantine.schema.json",
  "title": "IngestQuarantine",
  "description": "수집한 문서 하나를 이유와 원문을 붙여 격리한 행",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siem_profile",
    "source_kind",
    "source_key",
    "siem_ref",
    "reason_code",
    "original_text",
    "seen_at"
  ],
  "properties": {
    "siem_profile": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": ["alert", "event"]
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "siem_ref": {
      "description": "위치와 안정 해시를 담은 격리 전용 합성 키",
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "original_text": {
      "description": "격리 전 원문을 json.dumps(ensure_ascii=True) 규칙으로 직렬화한 글자",
      "type": "string"
    },
    "seen_at": {
      "$ref": "common/types.schema.json#/definitions/epoch_ms"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "normalize_failure.schema.json",
  "title": "NormalizeFailure",
  "type": "object",
  "properties": {
    "scenario": {
      "type": "string"
    },
    "raw_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^raw_"
      }
    },
    "reason": {
      "type": "string",
      "enum": [
        "unknown_scenario",
        "missing_required",
        "bad_value"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "failed_at": {
      "type": "integer"
    }
  },
  "required": [
    "scenario",
    "raw_ids",
    "reason",
    "missing_fields",
    "detail",
    "failed_at"
  ],
  "additionalProperties": false
}

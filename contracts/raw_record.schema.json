{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "raw_record.schema.json",
  "title": "RawRecord",
  "type": "object",
  "properties": {
    "raw_id": {
      "type": "string",
      "pattern": "^raw_"
    },
    "source_type": {
      "type": "string",
      "description": "Registered value; built-in values: web, cloud. Plugins may register more values; the core registry validates them."
    },
    "received_at": {
      "type": "integer"
    },
    "payload": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    }
  },
  "required": [
    "raw_id",
    "source_type",
    "received_at",
    "payload",
    "sha256"
  ],
  "additionalProperties": false,
  "description": "Core follow-up: check sha256 against the unchanged payload."
}

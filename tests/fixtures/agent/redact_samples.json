    },
    {
      "name": "common_word_user_name",
      "text": "{\"user.name\": \"admin\", \"message\": \"login-failed admin from 198.51.100.7\"}"
    },
    {
      "name": "plain_words_near_secret_names",
      "text": "tokenizer=whitespace secretary=Kim passwordless login for deploy"
    },
    {
      "name": "pagination_cursors",
      "text": "GET /events?next_token=eyJvZmZzZXQiOjIwfQ&page_token=cursor-0020&next_page_token=cursor-0040&continuation_token=cursor-0060"
    },
    {
      "name": "token_count_style_fields",
      "text": "{\"tokens_in\": 120, \"tokens_out\": 8, \"token_count\": 5, \"max_tokens\": 4096, \"secret_santa\": true, \"secretKeeper\": \"bob\"}"
    },
    {
      "name": "prose_mentioning_token_and_secret",
      "text": "Invalid token provided for user alice from 203.0.113.9; the secret santa party is on Friday"
    }
  ],
  "masked": [
    {
      "name": "url_query_token",
      "text": "GET /export?page=2&token=fake-token-abcdef123456&sort=asc HTTP/1.1",
      "secret": "fake-token-abcdef123456",
      "keep": ["page=2", "sort=asc"]
    },
    {
      "name": "url_query_access_token_and_secret",
      "text": "GET /cb?access_token=fake-access-0001&client_secret=fake-client-0002&state=ok",
      "secret": ["fake-access-0001", "fake-client-0002"],
      "keep": ["state=ok"]
    },
    {
      "name": "authorization_basic_header",
      "text": "GET /admin HTTP/1.1 Authorization: Basic ZmFrZXVzZXI6ZmFrZXBhc3M= User-Agent: curl/8.0",
      "secret": "ZmFrZXVzZXI6ZmFrZXBhc3M=",
      "keep": ["User-Agent: curl/8.0"]
    },
    {
      "name": "authorization_apikey_header",
      "text": "{\"headers\": \"Authorization: ApiKey ZmFrZS1hcGkta2V5LTAwMDE=\"}",
      "secret": "ZmFrZS1hcGkta2V5LTAwMDE=",
      "keep": []
    },
    {
      "name": "authorization_json_key",
      "text": "{\"authorization\": \"Digest username=fake, response=fake-digest-0003\", \"method\": \"GET\"}",
      "secret": "fake-digest-0003",
      "keep": ["\"method\": \"GET\""]
    },
    {
      "name": "pwd_query_value",
      "text": "POST /login?user=alice&pwd=fake-pwd-0004 HTTP/1.1",
      "secret": "fake-pwd-0004",
      "keep": ["user=alice"]
    }
  ]
